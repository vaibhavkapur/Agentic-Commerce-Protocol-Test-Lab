{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commerce-lab.local/schemas/suite.schema.json",
  "title": "Commerce Lab Suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "description", "cases"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "cases": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Scenario file paths relative to the suites directory." }
  }
}
